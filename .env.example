# Copy to .env and fill in. Never commit .env (the template's .gitignore ignores it).
# Never put a value in this file: no key, no endpoint, no default (AGENTS.md G3, G13).
# The environment wins over .env; `.env.local` wins over `.env` (src/cli.py, src/suva_data/config.py).

# --- Apertus gateway (src/llm/config.py) ---------------------------------------------------------------
# Required in live mode (`make run-live`, `make triage MODE=live`); startup fails if one is missing (G3).
# Not needed in replay mode (D-032).
# The model id; must name an Apertus model (MODELS.md §1).
LLM_NAME=
# The OpenAI-compatible base URL of the gateway.
LLM_BASE_URL=
# The gateway key.
LLM_API_KEY=

# Optional (docs/ARCHITECTURE.md §4). Empty means "use the code's default".
# The small model for cheap calls; defaults to LLM_NAME.
LLM_NAME_SMALL=
# Concurrent calls from this machine (the team total stays <= 16, G2).
LLM_CONCURRENCY=
# Timeout of one gateway call, in seconds.
LLM_TIMEOUT_S=
# Input budget per call, in tokens (G4).
LLM_MAX_INPUT_TOKENS=

# Data layer (docs/DB_DDL_PLANNING.md §15.6). DATABASE_URL names the login; no password in the repo (G13).
# Every pipeline session then runs SET ROLE to the pipeline group (least privilege, F-11): suva_g_pipeline unless
# the environment sets DB_PIPELINE_ROLE to another group the login may take. Only an exported empty value
# (DB_PIPELINE_ROLE= in the shell; .env never sets an empty value) keeps the login's own rights, with a warning.
# A role that is missing or not granted to the login fails the connection, naming the fix.
# SET ROLE is not a security boundary: code on the connection can RESET ROLE to the login's rights. For real least
# privilege, DATABASE_URL names a login whose only membership is the pipeline group (suva_pipeline), never the owner
# or a superuser (the local container's trust login is one: fine for development, not for a shared database).
DATABASE_URL=

# Cluster (docker compose, docs/DEPLOY.md). Secrets: at least 16 characters each, generated per installation.
# POSTGRES_PASSWORD: the owner (migrate, backup). SUVA_PIPELINE_PASSWORD: the jobs. SUVA_API_PASSWORD: the app.
# SUVA_REPORT_PASSWORD: read-only access for the report and the judges. Empty = that login cannot connect.
POSTGRES_PASSWORD=
SUVA_PIPELINE_PASSWORD=
SUVA_API_PASSWORD=
SUVA_REPORT_PASSWORD=
# Optional. MODE: replay (default, no key) or live. HF_BASE_SOURCE: a host directory holding bger.parquet
# instead of the hf_base volume (air-gapped). SUVA_DERIVED_SOURCE: a host directory mounted as data/derived (the
# recorded answers a replayed layer 2 reads; Suva-derived, D-031). SUVA_IMAGE: a registry image instead of the local build.
MODE=
HF_BASE_SOURCE=
SUVA_DERIVED_SOURCE=
SUVA_IMAGE=
APP_BIND=
APP_PORT=
BACKUP_TARGET=
# Sovereign inference (profile sovereign, docs/DEPLOY.md §6): weights directory or volume, model folder, served
# name (must be on the allow-list of MODELS.md §1), GPUs per replica, context length.
APERTUS_WEIGHTS_SOURCE=
APERTUS_MODEL_DIR=
APERTUS_SERVED_NAME=
VLLM_TENSOR_PARALLEL=
VLLM_MAX_MODEL_LEN=

# HTTP API (docs/API.md, D-092). All optional; empty means "use the code's default":
# API_HOST 127.0.0.1, API_PORT 8000, API_ACTOR expert, API_DB_ROLE suva_api, API_STATEMENT_TIMEOUT_MS 15000,
# API_MAX_DB_SESSIONS 12 (1 to 20).
# API_RUNS_ENABLED=1 lets POST /api/runs launch layer 1 then layer 2; PIPELINE_DATABASE_URL names the pipeline login
# for those runs (default: DATABASE_URL); API_LAYER2_STORE and API_LAYER2_POPULATIONS (comma-separated) become
# --store and --population of layer 2. Keep API_AI_RELEVANT_MIN_SCORE empty while D-021 is open.
API_HOST=
API_PORT=
API_RUNS_ENABLED=
PIPELINE_DATABASE_URL=
API_LAYER2_STORE=
API_LAYER2_POPULATIONS=
API_AI_RELEVANT_MIN_SCORE=
# --- Database (src/suva_data/config.py) ----------------------------------------------------------------
# Your Postgres. Empty means the compose database, postgresql://suva@localhost:54329/suva, which
# `make run` starts itself (docker compose up -d --wait db). Form: postgresql://USER[:PASSWORD]@HOST:PORT/DB.
DATABASE_URL=
# Where data/ lives (snapshot, raw cache, dump, manifest). Empty means <repo>/data.
SUVA_DATA_DIR=
# Tests only: the whole URL of the test database (its name must contain "test"). Empty means
# DATABASE_URL with the database name suva_test (tests/conftest.py).
SUVA_TEST_DATABASE_URL=

# --- make run (src/cli.py, Makefile) -------------------------------------------------------------------
# How many rulings `make run` summarises (the top suspected-relevant ones without a summary); 0 skips.
# Default 5. `make run SUMMARY_LIMIT=N` overrides it.
SUMMARY_LIMIT=
# Which writer writes the fiches: extract (the v1 summaries, built from the ruling's own sentences, each one
# traced to its consideration; docs/EXTRACT.md) or v2 (one prompt per fiche). Empty means v2; set extract in your
# .env for the v1 summaries. A ruling the extractive writer cannot read gets the v2 fiche instead.
SUMMARY_WRITER=
# Address the API and UI listen on. Defaults 127.0.0.1 and 8000 (the Docker image sets SUVA_HOST=0.0.0.0).
SUVA_HOST=
SUVA_PORT=

# --- Evaluation judge of the summaries (src/llm/judge.py, docs/JUDGE.md) ------------------------------
# Never Apertus, never used by `make run`. All three are needed to run `python -m eval.judge.*`.
# The judge's model id.
JUDGE_MODEL=
# The judge's OpenAI-compatible base URL.
JUDGE_BASE_URL=
# The judge's key.
JUDGE_API_KEY=
# Optional reasoning effort; defaults to the highest level.
JUDGE_REASONING_EFFORT=
