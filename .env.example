# Copy to .env and fill in. Never commit .env (the template's .gitignore ignores it).
# Never put a value in this file: no key, no endpoint, no default (AGENTS.md G3, G13).

# Required in live mode; startup fails if one is missing (G3). Not needed in replay mode (D-032).
LLM_NAME=
LLM_BASE_URL=
LLM_API_KEY=

# Optional (docs/ARCHITECTURE.md §4). Empty means "use the code's default".
LLM_NAME_SMALL=
LLM_CONCURRENCY=
LLM_TIMEOUT_S=
LLM_MAX_INPUT_TOKENS=

# Optional: your own Postgres, if it differs from docker-compose.yml (user, password, port).
# Form: postgresql://USER:PASSWORD@HOST:PORT/DATABASE. Empty means "use the code's default".
# Read by suva_data (pipeline, app, tests); the environment wins over this file.
DATABASE_URL=

# Optional: the evaluation judge of the summaries (docs/JUDGE.md). Never Apertus, never used by `make run`.
# All three are needed to run `python -m eval.judge.*`; the effort defaults to the highest level.
JUDGE_MODEL=
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_REASONING_EFFORT=
