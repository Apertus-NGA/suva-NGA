# Copy to .env and fill in. Never commit .env (the template's .gitignore ignores it).
# Never put a value in this file: no key, no endpoint, no default (AGENTS.md G3, G13).

# Required in live mode; startup fails if one is missing (G3). Not needed in replay mode (D-032).
LLM_NAME=
LLM_BASE_URL=
LLM_API_KEY=

# Optional (docs/ARCHITECTURE.md §4). Empty means "use the code's default".
LLM_NAME_SMALL=
LLM_CONCURRENCY=
LLM_TIMEOUT_S=
LLM_MAX_INPUT_TOKENS=

# Cluster (docker compose, docs/DEPLOY.md). Secrets: at least 16 characters each, generated per installation.
# POSTGRES_PASSWORD: the owner (migrate, backup). SUVA_PIPELINE_PASSWORD: the jobs. SUVA_API_PASSWORD: the app.
# SUVA_REPORT_PASSWORD: read-only access for the report and the judges. Empty = that login cannot connect.
POSTGRES_PASSWORD=
SUVA_PIPELINE_PASSWORD=
SUVA_API_PASSWORD=
SUVA_REPORT_PASSWORD=
# Optional. MODE: replay (default, no key) or live. HF_BASE_SOURCE: a host directory holding bger.parquet
# instead of the hf_base volume (air-gapped). SUVA_IMAGE: a registry image instead of the local build.
MODE=
HF_BASE_SOURCE=
SUVA_IMAGE=
APP_BIND=
APP_PORT=
BACKUP_TARGET=
# Sovereign inference (profile sovereign, docs/DEPLOY.md §6): weights directory or volume, model folder, served
# name (must be on the allow-list of MODELS.md §1), GPUs per replica, context length.
APERTUS_WEIGHTS_SOURCE=
APERTUS_MODEL_DIR=
APERTUS_SERVED_NAME=
VLLM_TENSOR_PARALLEL=
VLLM_MAX_MODEL_LEN=
